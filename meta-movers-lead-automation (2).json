      },
      "id": "a1b2c3d4-0001-4001-8001-000000000001",
      "name": "Angi Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "a1b2c3d4-0001-4001-8001-webhook0001"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f0000000-0000-0000-0000-000000000001",
              "name": "firstName",
              "value": "={{ $json.body.firstName }}",
              "type": "string"
            },
            {
              "id": "f0000000-0000-0000-0000-000000000002",
              "name": "lastName",
              "value": "={{ $json.body.lastName }}",
              "type": "string"
            },
            {
              "id": "f0000000-0000-0000-0000-000000000003",
              "name": "email",
              "value": "={{ $json.body.email }}",
              "type": "string"
            },
            {
              "id": "f0000000-0000-0000-0000-000000000004",
              "name": "phone",
              "value": "={{ $json.body.primaryPhone }}",
              "type": "string"
            },
            {
              "id": "f0000000-0000-0000-0000-000000000005",
              "name": "phoneE164",
              "value": "={{ '+1' + ($json.body.primaryPhone || '').toString().replace(/\\D/g,'').slice(-10) }}",
              "type": "string"
            },
            {
              "id": "f0000000-0000-0000-0000-000000000006",
              "name": "movingFrom",
              "value": "={{ [$json.body.address, $json.body.city, $json.body.stateProvince, $json.body.postalCode].filter(Boolean).join(', ') }}",
              "type": "string"
            },
            {
              "id": "f0000000-0000-0000-0000-000000000007",
              "name": "movingTo",
              "value": "={{ ($json.body.interview && $json.body.interview.find(q => (q.question || '').toLowerCase().includes('where are you moving')) || {}).answer || '' }}",
              "type": "string"
            },
            {
              "id": "f0000000-0000-0000-0000-000000000008",
              "name": "moveDate",
              "value": "={{ ($json.body.interview && $json.body.interview.find(q => (q.question || '').toLowerCase().includes('when will you be moving')) || {}).answer || '' }}",
              "type": "string"
            },
            {
              "id": "f0000000-0000-0000-0000-000000000009",
              "name": "moveSize",
              "value": "={{ ($json.body.interview && $json.body.interview.find(q => (q.question || '').toLowerCase().includes('how large')) || {}).answer || '' }}",
              "type": "string"
            },
            {
              "id": "f0000000-0000-0000-0000-000000000010",
              "name": "moveScope",
              "value": "={{ ($json.body.interview && $json.body.interview.find(q => (q.question || '').toLowerCase().includes('same state')) || {}).answer || '' }}",
              "type": "string"
            },
            {
              "id": "f0000000-0000-0000-0000-000000000011",
              "name": "customerComments",
              "value": "={{ ($json.body.comments && !$json.body.comments.toLowerCase().includes('did not provide additional comments')) ? $json.body.comments : '' }}",
              "type": "string"
            },
            {
              "id": "f0000000-0000-0000-0000-000000000012",
              "name": "leadReceivedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-4002-8002-000000000002",
      "name": "Normalize Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.email }}",
        "subject": "We received your request — Meta Movers",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; color:#333; line-height:1.6;\">\n<p>Hi {{ $json.firstName }},</p>\n<p>Thank you for reaching out to <strong>Meta Movers</strong> through Angi! We've received your request and one of our team members is preparing your personalized moving quote right now — you'll receive it by email shortly.</p>\n<p>Here's what we have on file so far:</p>\n<ul>\n<li><strong>Moving from:</strong> {{ $json.movingFrom }}</li>\n<li><strong>Moving to:</strong> {{ $json.movingTo || 'to be confirmed on our call' }}</li>\n<li><strong>Preferred move date:</strong> {{ $json.moveDate || 'to be confirmed' }}</li>\n<li><strong>Home size:</strong> {{ $json.moveSize || 'to be confirmed' }}</li>\n</ul>\n{{ $json.customerComments ? '<p><em>Your note: ' + $json.customerComments + '</em></p>' : '' }}\n<p>If any of these details look off, or you'd like to add anything, just reply to this email or text us at (551) 309-3575 and we'll get it sorted before your quote goes out.</p>\n<p>Looking forward to helping you move!</p>\n<p>Warm regards,<br/>The Meta Movers Team<br/>(551) 309-3575</p>\n</div>",
        "options": {}
      },
