        "jsCode": "const wh=$('Webhook').first().json.body, s=$('Settings').first().json.settings;\nconst found=($json.QueryResponse&&$json.QueryResponse.Item&&$json.QueryResponse.Item[0])||null;\nconst today=new Date().toISOString().slice(0,10); let body=null;\nif(!found){ body=JSON.stringify({Name:String(wh.item_number),Sku:String(wh.item_number),Type:'Inventory',TrackQtyOnHand:true,QtyOnHand:0,InvStartDate:today,IncomeAccountRef:{value:s.qbo_income_account_id},AssetAccountRef:{value:s.qbo_inventory_asset_account_id},ExpenseAccountRef:{value:s.qbo_cogs_account_id},UnitPrice:Number(wh.retail||0),PurchaseCost:Number(wh.unit_cost||0)}); }\nreturn { json:{ itemId: found?found.Id:null, itemBody:body, skipCreate:!!found } };"
