        "jsCode": "const wh=$('Webhook').first().json.body;\nlet itemId=$('Rcv Item Body').first().json.itemId;\ntry{ const cr=$('Rcv Create Item').first().json; if(!itemId&&cr&&cr.Item) itemId=cr.Item.Id; }catch(e){}\nlet vendorId=$('Rcv Vendor Decide').first().json.vendorId;\ntry{ const cv=$('Rcv Create Vendor').first().json; if(!vendorId&&cv&&cv.Vendor) vendorId=cv.Vendor.Id; }catch(e){}\nconst qty=Number(wh.qty||0),cost=Number(wh.unit_cost||0);\nconst body={Line:[{DetailType:'ItemBasedExpenseLineDetail',Amount:qty*cost,ItemBasedExpenseLineDetail:{ItemRef:{value:itemId},Qty:qty,UnitPrice:cost}}]};\nif(vendorId) body.VendorRef={value:vendorId};\nreturn { json:{ billBody:JSON.stringify(body) } };"
